# Copy to .env and fill in. Shared by all three A2A containers. .env is gitignored.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Dedicated embedding endpoint (proactive recall on the concierge front door embeds each turn).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# A2A peer auth tokens (the front door presents these to the peers; each peer accepts them as
# inbound_tokens). Defaults match the configs; override for production.
PEER_IT_TOKEN=tok-it
PEER_FACILITIES_TOKEN=tok-fac

# Peer URLs default to the compose service names (http://peer-it:8000). Override only if you
# run the peers outside compose.
# PEER_IT_URL=http://peer-it:8000
# PEER_FACILITIES_URL=http://peer-facilities:8000
CONCIERGE_API_KEY=concierge-smoke-key-1234  # the key the employee/frontend presents to the concierge
