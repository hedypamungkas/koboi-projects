# Copy to .env and fill in. .env is gitignored -- never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Dedicated embedding endpoint (proactive recall embeds each turn).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Optional: outbound HMAC-signed webhook receiver for the weekly account-review job (CRM sync).
# Defaults to a local sink so the demo runs offline.
CRM_WEBHOOK_URL=http://localhost:9999/account-review
CRM_WEBHOOK_SECRET=
