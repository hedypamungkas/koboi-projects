# This project's docker-compose.yml points koboi's env_file at an absolute path
# outside this repo (the koboi-agent checkout's own .env), so this file is a
# reference only -- it documents which variables config/agent.yaml expects.
# Copy it to that external .env (or your own) and fill in real values; never
# commit real keys.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
