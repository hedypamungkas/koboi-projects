# Copy to .env and fill in. .env is gitignored -- never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Dedicated embedding endpoint (the chat gateway above usually has no /embeddings route).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Optional: outbound HMAC-signed webhook receiver for autonomous triage job completion.
# Defaults to a local sink so the demo runs offline.
CLAIMS_WEBHOOK_URL=http://localhost:9999/claims-triage
CLAIMS_WEBHOOK_SECRET=
