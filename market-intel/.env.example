# Copy to .env and fill in. .env is gitignored -- never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Web search provider for live research. "mock" (default) runs offline with scripted results;
# set to brave or firecrawl + the matching API key for real multi-source research.
WEB_SEARCH_PROVIDER=mock
WEB_FETCH_PROVIDER=httpx
BRAVE_API_KEY=
FIRECRAWL_API_KEY=

# Optional: outbound HMAC-signed webhook receiver for finished briefs.
# Defaults to a local sink so the demo runs offline.
BRIEF_WEBHOOK_URL=http://localhost:9999/market-brief
BRIEF_WEBHOOK_SECRET=
