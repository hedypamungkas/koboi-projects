# Copy this file to .env in this same directory and fill in real values.
# Never commit the real .env -- it's already gitignored.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Leave blank (or omit) to use OpenAI's default API endpoint; set this to point
# at a proxy/gateway instead.
OPENAI_BASE_URL=

# Optional: a dedicated embedding provider, only needed if OPENAI_BASE_URL above
# doesn't serve embedding models (see rag.retriever: hybrid in config/agent.yaml).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
