# This app doesn't read a local .env file directly -- docker-compose.yml
# points `env_file:` at the shared credentials file at:
#
#   /Users/mekari/Documents/Research-POC/ai-agent-sample/koboi-agent/.env
#
# (outside this repo, never committed). This file documents the variables that
# file must define; copy it there (or point your own credentials file at the
# same variables) if you're setting this app up fresh.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Leave blank (or omit) to use OpenAI's default API endpoint; set this to point
# at a proxy/gateway instead.
OPENAI_BASE_URL=
